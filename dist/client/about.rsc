2:["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero","children":["$","div",null,{"className":"site-shell page-hero__grid","children":[["$","p",null,{"className":"eyebrow motion-rise","children":"About Cecil Theatre Project"}],["$","div",null,{"className":"motion-rise motion-rise--delay","children":[["$","h1",null,{"children":"A theatre company at the beginning: on purpose."}],["$","p",null,{"children":"CTP is building opportunities for people to see and make theatre in Cecil County, starting with one production and a clear invitation to take part."}]]}]]}]}],["$","section",null,{"className":"section section--ivory","aria-labelledby":"position-heading","children":["$","div",null,{"className":"site-shell editorial-grid editorial-grid--wide","children":[["$","div",null,{"children":[["$","p",null,{"className":"kicker","children":"What we are"}],["$","h2",null,{"id":"position-heading","children":"Rooted here. Open to what theatre can become."}]]}],["$","div",null,{"className":"editorial-copy","children":[["$","p",null,{"className":"lead-copy","children":"Cecil Theatre Project is a new, locally rooted theatre organization creating opportunities to see, make, and participate in theatre in Cecil County."}],["$","p",null,{"children":"That means making room for audiences and theatre-makers at the same time: a clear night out for patrons, a serious creative process for artists, and practical ways for new collaborators to raise their hands."}],["$","p",null,{"children":"CTP is new. It has not built a long production history yet, and this website does not pretend otherwise. The inaugural production is the first public step in learning what the community wants, what the organization can sustain, and what deserves to come next."}]]}]]}]}],["$","section",null,{"className":"section section--paper","aria-labelledby":"principles-heading","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-he